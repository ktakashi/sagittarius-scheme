#!compatible
(library (sagittarius jit)
    (export :all)
    (import (core))
  (decl-code
   (.define "LIBSAGITTARIUS_BODY")
   (.include <sagittarius/private.h>
	     <sagittarius/private/instruction.h>
	     "jit/jit.h"))

  ;; JIT compilation procedures
  (define-c-proc jit-available? () ::<boolean> Sg_JitAvailable)
  (define-c-proc jit-enabled? () ::<boolean> Sg_JitEnabled)
  (define-c-proc jit-enabled-set! (enabled::<boolean>) ::<void> Sg_SetJitEnabled)
  (define-c-proc jit-threshold () ::<fixnum> Sg_GetJitThreshold)
  (define-c-proc jit-threshold-set! (threshold::<fixnum>) ::<void> Sg_SetJitThreshold)
  (define-c-proc jit-verbose? () ::<boolean> Sg_JitVerbose)
  (define-c-proc jit-verbose-set! (verbose::<boolean>) ::<void> Sg_SetJitVerbose)
  
  (define-c-proc jit-compiled? (cl::<procedure>) ::<boolean>
    (cond ((SG_CLOSUREP cl)
	   (result (not (== (-> (SG_CODE_BUILDER (-> (SG_CLOSURE cl) code)) jitCode) NULL)))
	   (result FALSE)))
    (else (result FALSE)))

  (define-c-proc jit-compile! (cl::<procedure>)
    (cond ((SG_CLOSUREP cl)
	   (let ((cb::SgCodeBuilder* (SG_CODE_BUILDER (-> (SG_CLOSURE cl) code))))
	     (when (== (-> cb jitCode) NULL)
	       (let ((compiled::SgJitCompiledCode (Sg_JitCompile cb)))
		 (when (!= compiled NULL)
		   (set! (-> cb jitCode) compiled)
		   (set! (-> cb jitFlags)
			 (logior (-> cb jitFlags) SG_JIT_FLAG_COMPILED)))))
	     (result (?: (== (-> cb jitCode) NULL) SG_FALSE SG_TRUE))))
	  (else (result SG_FALSE))))
  
  (define-c-proc jit-disassemble (cl::<procedure> :optional (port::<port> (Sg_CurrentOutputPort)))
    ::<void>
    (unless (SG_OUTPUT_PORTP port)
      (wrong-type-of-argument-violation 'jit-disassemble "output port" port))
    (cond ((SG_CLOSUREP cl)
	   (Sg_JitDisassemble (SG_CODE_BUILDER (-> (SG_CLOSURE cl) code)) port))
	  (else (Sg_Printf port (UC "Not a closure\n")))))
  
  (define-c-proc jit-profile-reset! () ::<void> Sg_JitProfileReset)
  
  (define-c-proc jit-profile-enable! (enable::<boolean>) ::<void> 
    Sg_JitProfileEnable)

  (define-c-proc jit-profile-print (:optional (port::<port> (Sg_CurrentOutputPort))) ::<void>
    (unless (SG_OUTPUT_PORTP port)
      (wrong-type-of-argument-violation 'jit-profile-print "output port" port))
    (Sg_JitProfilePrint port))
  
  (define-c-proc enable-jit () (Sg_SetJitEnabled TRUE))
  (define-c-proc disble-jit () (Sg_SetJitEnabled FALSE))
)