#!/usr/bin/env sagittarius
(import (rnrs))

(define d (expt 3 4096))
(define c (expt 2 2048))

(print "Dividend (3^4096):")
(print (number->string d 16))
(print "")
(print "Divisor (2^2048):")
(print (number->string c 16))
(print "")
(print "Expected quotient:")
(print "")
(print "")
(print "Actual quotient:")
(print (div d c))
(print "")
(print "Remainder:")
(print (mod d c))
(print "")
(print "Verification (quotient * divisor + remainder = dividend):")
(let ((quotient (div d c))
      (remainder (mod d c)))
  (print (= d (+ (* quotient c) remainder))))